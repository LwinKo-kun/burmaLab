{
  "expo": {
    "name": "burmaLab",
    "slug": "burmaLab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Assets/lab_icon.png",
    "scheme": "burmalab",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/expo.icon/Assets/lab_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#208AEF"
    },
    "ios": {
      "icon": "./assets/expo.icon/Assets/lab_icon.png",
      "splash": {
        "image": "./assets/expo.icon/Assets/lab_icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#208AEF"
      }
    },
    "android": {
      "icon": "./assets/expo.icon/Assets/lab_icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.burmaLab"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd4b54fa-835c-4c5e-8887-635e861d13bf"
      }
    }
  }
}
